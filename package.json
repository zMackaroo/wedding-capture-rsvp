{
  "name": "capture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host\" \"npm run dev --prefix ../capture-api\"",
    "dev:web": "vite --host",
    "dev:api": "npm run dev --prefix ../capture-api",
    "build": "tsc -b && vite build",
    "start:api": "npm start --prefix ../capture-api",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "googleapis": "^174.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
